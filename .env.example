# Скопируйте в .env и заполните. .env в git не попадает.

# Многоразовый setup key Netbird с auto-assign группы agh-replica.
# Консоль: app.netbird.io → Setup Keys → Create Setup Key (Reusable).
NB_KEY=

# SSH-хост origin-ноды — куда ходят make-template и операции с парком.
ORIGIN_HOST=node01

# Номер origin-ноды. Адрес шлюза выводится как 10.(100+NUM).0.1
ORIGIN_NUM=1

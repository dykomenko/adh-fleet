# Скопируйте в .env и заполните. .env в git не попадает.
# Это файл рабочей машины: на ноды ничего из него не копируется,
# значения передаются в командной строке при установке.
#
# Значения берите в ОДИНАРНЫЕ КАВЫЧКИ: в bcrypt-хеше есть $, и без них
# оболочка попытается раскрыть его как переменную, а скрипты падают
# с «unbound variable».

# Setup key для origin-ноды. Auto-assign группы agh-origin.
NB_KEY_ORIGIN=''

# Многоразовый setup key для реплик. Auto-assign группы agh-replica.
# Консоль: app.netbird.io -> Setup Keys -> Create Setup Key (Reusable).
NB_KEY_REPLICA=''

# bcrypt-хеш пароля админа AdGuard Home.
# Печатается скриптом scripts/make-template.sh на origin-ноде.
AGH_PASS_HASH=''

# Хосты парка для scripts/fleet-update.sh, через пробел.
# Можно не заполнять — хосты передаются аргументами.
NODES='node01 node02 node03'

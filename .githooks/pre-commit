#!/usr/bin/env bash
#
# Не даёт закоммитить секреты. Репозиторий публичный — цена ошибки высокая.
# Ставится так:  git config core.hooksPath .githooks
#
# Ловит: setup key Netbird (UUID), bcrypt-хеши, приватные ключи, сам .env.
# Обойти осознанно:  git commit --no-verify

set -uo pipefail

# Только добавляемые строки. awk, а не grep: в BRE обратный слеш перед плюсом
# означает квантификатор, а не литерал, и фильтр заголовков '+++' молча
# выбрасывал весь ввод.
ADDED="$(git diff --cached -U0 --no-color | awk '/^\+/ && !/^\+\+\+/')"

fail=0

check() {
  local pattern="$1" what="$2" hits
  hits="$(printf '%s\n' "$ADDED" | grep -Ei "$pattern" || true)"
  if [[ -n "$hits" ]]; then
    echo "ОТКАЗ: похоже на $what" >&2
    printf '%s\n' "$hits" | sed 's/^/    /' >&2
    fail=1
  fi
}

# UUID в верхнем регистре, группы 8-4-4-4-12 — формат setup key Netbird.
# Литеральный пример здесь не приводится намеренно: он сработал бы сам на себя.
check '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' 'setup key Netbird'
check '\$2[aby]\$[0-9]{2}\$[A-Za-z0-9./]{20,}'                       'bcrypt-хеш пароля'
check 'BEGIN [A-Z ]*PRIVATE KEY'                                      'приватный ключ'

# .env не должен попадать в индекс ни при каких условиях
if git diff --cached --name-only | grep -qx '\.env'; then
  echo "ОТКАЗ: .env в индексе — он должен оставаться вне репозитория" >&2
  fail=1
fi

if (( fail )); then
  echo >&2
  echo "Коммит остановлен. Секретам место в ../.env, вне рабочего дерева." >&2
  exit 1
fi

exit 0
